{
  "manifest_version": 2,
  "name": "Ghalamnama Multilingual Keyboard",
  "description": "A per-tab Persian, Arabic, Hebrew, Russian, and Greek keyboard for text fields.",
  "version": "3.2.0",
  "homepage_url": "https://ghalamnama.online/",
  "browser_specific_settings": {
    "gecko": {
      "id": "keyboard@ghalamnama.online",
      "strict_min_version": "143.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "<all_urls>"
  ],
  "browser_action": {
    "default_title": "Ghalamnama keyboard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "19": "icons/icon-19.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png",
      "38": "icons/icon-38.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-activation": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "MacCtrl+Shift+G"
      },
      "description": "Activate or deactivate Ghalamnama on the current tab"
    },
    "toggle-keyboard": {
      "description": "Open or close the Ghalamnama keyboard on the active tab"
    },
    "toggle-typing-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "MacCtrl+Shift+Space"
      },
      "description": "Switch between Ghalamnama and system keyboard typing"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png"
  }
}
