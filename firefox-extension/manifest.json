{
  "manifest_version": 2,
  "name": "Ghalamnama Persian Arabic Keyboard",
  "description": "An on-screen Persian and Arabic keyboard for text fields.",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "keyboard@ghalamnama.online",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "css": ["keyboard.css"],
      "run_at": "document_idle"
    }
  ]
}