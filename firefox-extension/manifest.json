{
  "manifest_version": 2,
  "name": "Ghalamnama Multilingual Keyboard",
  "description": "A per-tab Persian, Arabic, Hebrew, Russian, and Greek keyboard for text fields.",
  "version": "3.2.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "keyboard@ghalamnama.online",
      "strict_min_version": "143.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "<all_urls>"],
  "browser_action": {
    "default_title": "Ghalamnama keyboard",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-keyboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "MacCtrl+Shift+Space"
      },
      "description": "Open or close the Ghalamnama keyboard on the active tab"
    }
  },
  "background": {
    "scripts": ["background.js"]
  }
}
